{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nombre del worker en Cloudflare. Se mantiene "timezone-toolkit" (invisible
  // para usuarios, que solo ven api.agishub.com) porque renombrarlo exigiría
  // recrear todos los secretos, cuyos valores no tenemos. Carpeta/npm/GitHub =
  // agishub-mcp; el nombre del worker puede diferir sin problema.
  "name": "timezone-toolkit",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "api.agishub.com", "custom_domain": true },
    { "pattern": "timezone-toolkit.agishub.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  // Self service-binding: lets the health probe / warmer call our own routes.
  // (A plain HTTP self-fetch to our custom domain is a same-zone subrequest → 522,
  // and an in-process app.fetch hangs, so this is the supported way.)
  "services": [{ "binding": "SELF", "service": "timezone-toolkit" }],
  "vars": {
    "X402_PAY_TO": "0x23Fc725e8EAa1c58900C6507Ba89be99a6DFc75d",
    "X402_NETWORK": "base",
    "X402_PRICE": "$0.02",
    "X402_FACILITATOR_URL": ""
  },
  "analytics_engine_datasets": [{ "binding": "AE", "dataset": "tzk_calls" }],
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [{ "binding": "LINKS", "id": "7c51149b42224e2297ca49db0b22d758" }],
  // Trazas de uso (todas las llamadas y respuestas) — consultables en /console.
  "d1_databases": [
    { "binding": "TRACES", "database_name": "agishub-traces", "database_id": "c8074d53-e34c-4ecd-87e6-dbceb54c55c8", "migrations_dir": "migrations" }
  ],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "agishub-memory" }],
  "queues": {
    "producers": [{ "queue": "agishub-webhooks", "binding": "WEBHOOK_QUEUE" }],
    "consumers": [{ "queue": "agishub-webhooks", "max_retries": 6, "max_batch_size": 10, "max_batch_timeout": 5 }]
  },
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "TimezoneToolkitMCP" },
      { "name": "TIMEZONE_MCP", "class_name": "TimezoneMCP" },
      { "name": "WEB_MCP", "class_name": "WebScraperMCP" },
      { "name": "AI_MCP", "class_name": "AiMCP" },
      { "name": "MEMORY_MCP", "class_name": "MemoryMCP" },
      { "name": "WEBHOOK_MCP", "class_name": "WebhookMCP" },
      { "name": "CRYPTO_MCP", "class_name": "CryptoMCP" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TimezoneToolkitMCP"] },
    { "tag": "v2", "new_sqlite_classes": ["TimezoneMCP", "WebScraperMCP"] },
    { "tag": "v3", "new_sqlite_classes": ["AiMCP", "MemoryMCP", "WebhookMCP", "CryptoMCP"] }
  ]
}
